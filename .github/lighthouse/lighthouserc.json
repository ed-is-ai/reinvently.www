{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "//": "The preset asserts all 175 audits. 41 of them pass on every page today, so this locks in that state for free and they only ever fire on a regression. Everything overridden below was measured failing across 72 desktop and mobile reports on 2 August 2026 — nothing here is guessed.",
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }],

        "//1": "Fixable, and being fixed. Promote each to error once green — errors-in-console is only failing because favicon.ico 404s on every page.",
        "errors-in-console": "warn",
        "color-contrast": "warn",
        "td-has-header": "warn",
        "heading-order": "warn",
        "aria-allowed-role": "warn",

        "//2": "Not fixable on GitHub Pages, which sets Cache-Control itself. Asserting these buys a permanent red.",
        "uses-long-cache-ttl": "off",
        "cache-insight": "off",

        "//3": "Timing metrics. Real signal lives in categories:performance above; asserting each one turns runner noise into failures.",
        "first-contentful-paint": "off",
        "largest-contentful-paint": "off",
        "largest-contentful-paint-element": "off",
        "lcp-discovery-insight": "off",
        "lcp-lazy-loaded": "off",
        "cumulative-layout-shift": "off",
        "layout-shifts": "off",
        "cls-culprits-insight": "off",
        "total-blocking-time": "off",
        "max-potential-fid": "off",
        "interactive": "off",
        "speed-index": "off",
        "mainthread-work-breakdown": "off",
        "forced-reflow-insight": "off",

        "//4": "Known work: oversized hero images, the GoDaddy bundles, and the homepage's inline CSS. Tracked as tasks, not as a daily red run.",
        "uses-responsive-images": "off",
        "modern-image-formats": "off",
        "uses-optimized-images": "off",
        "image-delivery-insight": "off",
        "offscreen-images": "off",
        "unused-javascript": "off",
        "unused-css-rules": "off",
        "legacy-javascript": "off",
        "render-blocking-resources": "off",
        "render-blocking-insight": "off",
        "network-dependency-tree-insight": "off",
        "uses-rel-preconnect": "off",
        "font-display-insight": "off",
        "total-byte-weight": "off",
        "dom-size": "off",
        "dom-size-insight": "off",
        "third-party-summary": "off",
        "unsized-images": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
