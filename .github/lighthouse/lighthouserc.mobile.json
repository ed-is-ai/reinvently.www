{
  "ci": {
    "collect": {
      "numberOfRuns": 3
    },
    "assert": {
      "//": "Same preset and overrides as the desktop config, plus the three mobile-only audits. Kept as a separate file rather than shared, because the two differ in ways that matter and a shared base would hide that.",
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],

        "//0": "0.7 against desktop's 0.8: throttled mobile scores run lower for the same page, and the homepage swings between 57 and 82 across runs.",
        "categories:performance": ["warn", { "minScore": 0.7 }],

        "//1": "Mobile-only, and passing everywhere today.",
        "viewport": ["error", { "minScore": 1 }],
        "font-size": ["warn", { "minScore": 1 }],
        "tap-targets": ["warn", { "minScore": 1 }],

        "//2": "Fixable, and being fixed.",
        "errors-in-console": "warn",
        "color-contrast": "warn",
        "td-has-header": "warn",
        "heading-order": "warn",
        "aria-allowed-role": "warn",

        "//3": "Not fixable on GitHub Pages.",
        "uses-long-cache-ttl": "off",
        "cache-insight": "off",

        "//4": "Timing metrics — noisy under mobile throttling in particular.",
        "first-contentful-paint": "off",
        "largest-contentful-paint": "off",
        "largest-contentful-paint-element": "off",
        "lcp-discovery-insight": "off",
        "lcp-lazy-loaded": "off",
        "cumulative-layout-shift": "off",
        "layout-shifts": "off",
        "cls-culprits-insight": "off",
        "total-blocking-time": "off",
        "max-potential-fid": "off",
        "interactive": "off",
        "speed-index": "off",
        "mainthread-work-breakdown": "off",
        "forced-reflow-insight": "off",

        "//5": "Known work, tracked as tasks.",
        "uses-responsive-images": "off",
        "modern-image-formats": "off",
        "uses-optimized-images": "off",
        "image-delivery-insight": "off",
        "offscreen-images": "off",
        "unused-javascript": "off",
        "unused-css-rules": "off",
        "legacy-javascript": "off",
        "render-blocking-resources": "off",
        "render-blocking-insight": "off",
        "network-dependency-tree-insight": "off",
        "uses-rel-preconnect": "off",
        "font-display-insight": "off",
        "total-byte-weight": "off",
        "dom-size": "off",
        "dom-size-insight": "off",
        "third-party-summary": "off",
        "unsized-images": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
